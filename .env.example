# A Neon API key (Account settings > API keys). The scripts create one
# project, create and delete branches in it, and read compute state.
NEON_API_KEY=

# Optional
# NEON_REGION=aws-eu-central-1
# SUSPEND_TIMEOUT=60     # stage 1; 60 s needs a plan that lets you set it (Scale)
# POLL_MS=2000           # how often the compute state is read
# HOURS=12               # stage 3
